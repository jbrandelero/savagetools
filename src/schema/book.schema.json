{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swade-compendium/book.schema.json",
  "title": "SWADE Book",
  "type": "object",
  "required": ["id", "title", "abbrev", "entries"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "abbrev": { "type": "string" },
    "languages": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "string" },
    "publisher": { "type": "string" },
    "category": { "type": "string" },
    "cover": { "type": "string" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "localizedText": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "minProperties": 1
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": ["type", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "type": {
          "enum": [
            "edge",
            "hindrance",
            "power",
            "skill",
            "gear",
            "weapon",
            "armor",
            "vehicle",
            "ancestry",
            "rule",
            "setting-rule",
            "bestiary"
          ]
        },
        "name": { "$ref": "#/definitions/localizedText" },
        "category": { "type": "string" },
        "rank": {
          "enum": ["novice", "seasoned", "veteran", "heroic", "legendary"]
        },
        "requirements": { "$ref": "#/definitions/localizedText" },
        "summary": { "$ref": "#/definitions/localizedText" },
        "description": { "$ref": "#/definitions/localizedText" },
        "page": { "type": "integer", "minimum": 0 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "fields": { "type": "object" }
      }
    }
  }
}
